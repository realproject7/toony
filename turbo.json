{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "studio/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@toony/studio#typecheck": {
      // The studio typecheck reads Next's generated `.next/types` (route/page
      // type defs). Those are produced by `next build`/`next typegen`, NOT by
      // upstream package builds, so `^build` alone leaves them missing on a cold
      // cache (#84). Depend on the studio's OWN build so `.next/types` exists
      // before tsc runs AND so a concurrent `next build` (triggered for the CLI's
      // studio bundling) can never clobber `.next/types` mid-typecheck — build
      // completes first, then typecheck runs against its output.
      "dependsOn": ["^build", "build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // A package's `test` compiles the same sources as its `build`, tests
      // included. It emits into `dist-test`, never into `dist`, and says so
      // here. Two reasons, both of them defects that were live before #253:
      //
      //  - `test` has no edge to its OWN package's `build` (it does not need
      //    one: it reads its dependencies' `dist`, not its own). So the two run
      //    at the same time inside one `turbo run test`. Sharing one output
      //    directory let them overwrite each other's files mid-emit, and let a
      //    consumer import a half-written module.
      //  - An emit turbo does not know about is an emit that makes the task
      //    summary lie. `build` declares `dist/**`; a `test` that also wrote
      //    there left `dist` holding test output while `build` reported FULL
      //    TURBO, so a green summary and the built artifact disagreed.
      //
      // The rule this encodes — every emitting task declares its own output
      // directory and shares it with no other task — is enforced by
      // `scripts/check-task-outputs.mjs`, which runs in `pnpm check`.
      "outputs": ["dist-test/**"]
    }
  }
}
